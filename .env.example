# Copy to .env.local and fill it in.

# --- Claude (the agent's brain; required for the chat) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# Safety cap for public demos: max Claude API calls per server process per day.
DEMO_MAX_CLAUDE_CALLS_PER_DAY=300

# --- PayPal (sandbox only) ---
# Create a REST app at https://developer.paypal.com/dashboard/ (Sandbox) and paste its credentials.
# Without them, payments run against a clearly labeled built-in simulator (no network).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- App ---
# Public base URL of this app; PayPal redirects the buyer back here after approval.
# Optional: when empty it is RENDER_EXTERNAL_URL on Render, or the request's origin locally.
APP_BASE_URL=http://localhost:3000
